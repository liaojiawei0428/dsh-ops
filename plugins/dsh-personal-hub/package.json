{
  "name": "dsh-personal-hub",
  "version": "0.1.0",
  "description": "个人部署层：按声明式清单重建 web profile 的依赖、bundles 与 patch 托管条目（清单外项只补不删）",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
